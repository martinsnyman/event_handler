<%- include('partials/page-start.ejs', { title: 'Edit Event' }) %>

<h1>Organiser Edit Event Page</h1>

<section class="card">
    <p class="muted">Event creation date: <%= event.created_at %></p>

    <% if (error) { %>
        <p class="alert"><%= error %></p>
    <% } %>

    <form action="/organiser/events/<%= event.event_id %>/edit" method="post" class="form">
        <label class="label" for="title">Event title</label>
        <input class="input" id="title" type="text" name="title" value="<%= event.title %>" required />

        <label class="label" for="description">Event description</label>
        <textarea class="textarea" id="description" name="description" required><%= event.description %></textarea>

        <label class="label" for="event_datetime">Event date</label>
        <input class="input" id="event_datetime" type="datetime-local" name="event_datetime" value="<%= event.event_datetime %>" required />

        <div class="grid-2">
            <div>
                <h2 class="card-title">Full-price tickets</h2>
                <label class="label" for="full_ticket_total">Number of tickets</label>
                <input class="input" id="full_ticket_total" type="number" min="0" step="1" name="full_ticket_total" value="<%= event.full_ticket_total %>" required />

                <label class="label" for="full_ticket_price">Price (£)</label>
                <input class="input" id="full_ticket_price" type="number" min="0" step="0.01" name="full_ticket_price" value="<%= event.full_ticket_price_display %>" required />
            </div>
            <div>
                <h2 class="card-title">Student Tickets</h2>
                <label class="label" for="concession_ticket_total">Number of tickets</label>
                <input class="input" id="concession_ticket_total" type="number" min="0" step="1" name="concession_ticket_total" value="<%= event.concession_ticket_total %>" required />

                <label class="label" for="concession_ticket_price">Price (£)</label>
                <input class="input" id="concession_ticket_price" type="number" min="0" step="0.01" name="concession_ticket_price" value="<%= event.concession_ticket_price_display %>" required />
            </div>
        </div>

        <div class="actions">
            <button class="button" type="submit">Submit changes</button>
            <a class="button button-secondary" href="/organiser">Back</a>
        </div>
    </form>
</section>

<%- include('partials/page-end.ejs') %>
